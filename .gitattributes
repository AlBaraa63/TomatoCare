# Normalise line endings across Windows / WSL / macOS / Linux.
# Without this, every git pull on a fresh OS rewrites every file and
# generates noise diffs that mask real changes.
*           text=auto

# Shell scripts MUST stay LF — CRLF breaks them under /bin/sh.
*.sh        text eol=lf
gradlew     text eol=lf

# Windows-only scripts stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binaries — never touch.
*.docx      binary
*.pdf       binary
*.jar       binary
*.tflite    binary
*.keras     binary
*.h5        binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.so        binary
*.zip       binary
*.gz        binary
