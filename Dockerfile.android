# ── TomatoCare Android build ──────────────────────────────────────────────────
FROM eclipse-temurin:17-jdk-jammy

ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget unzip \
    && rm -rf /var/lib/apt/lists/*

# Download Android command-line tools.
# If this URL is stale, get the latest from developer.android.com/studio#command-line-tools-only
RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
         -O /tmp/cmdline-tools.zip && \
    unzip -q /tmp/cmdline-tools.zip -d $ANDROID_HOME/cmdline-tools && \
    mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip

RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager "platforms;android-34" "build-tools;34.0.0" "platform-tools"

WORKDIR /app

COPY android/ android/

# Remove the Windows/Android-Studio JVM path — Docker uses JAVA_HOME from the base image
RUN sed -i '/^org.gradle.java.home=/d' android/gradle.properties

# Pre-fetch Gradle and all dependency JARs so repeated builds stay fast
RUN cd android && ./gradlew :app:dependencies --no-daemon --quiet 2>&1 | tail -3 || true

CMD ["bash", "-c", \
     "cd android && ./gradlew :app:assembleDebug --no-daemon && \
      echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'"]
